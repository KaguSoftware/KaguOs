# Every variable KaguOs reads, with no values in it. Copy to .env.local and fill
# in. The Supabase keys are on the project's API settings page; the email ones
# come from Resend.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Server-side only, never prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Only for the migration scripts in scripts/ — the app itself never reads it.
SUPABASE_ACCESS_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Leave both blank and the app runs exactly as before: the send box says email
# isn't configured, and nothing is ever posted to Resend. See lib/email/config.ts.
#
# The key is created at resend.com/api-keys and needs only "Sending access".
RESEND_API_KEY=
# The from-line, in RFC 5322 form: KaguOs <hello@kagusoftware.com>
# The domain must be VERIFIED in Resend (three DNS records) or every send is
# refused with a 403 — a Gmail address will not work here.
EMAIL_FROM=
# Optional. Where a client's reply lands; blank sends replies back to EMAIL_FROM.
EMAIL_REPLY_TO=

# ── Links in outgoing email ─────────────────────────────────────────────────
# The origin every emailed link is built from, no trailing slash. On Vercel this
# can be left blank — VERCEL_PROJECT_PRODUCTION_URL is used instead. Set it as
# soon as there is a custom domain: that is the address a client should see.
NEXT_PUBLIC_SITE_URL=

# ── Deployment ──────────────────────────────────────────────────────────────
VERCEL_TOKEN=
